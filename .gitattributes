# Auto detect text files and normalize line endings to LF
* text=auto

# Source code
*.py text eol=lf
*.go text eol=lf
*.java text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.bash text eol=lf

# Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.gz binary
*.zip binary
*.tar binary

# Docker
Dockerfile text eol=lf
.dockerignore text eol=lf

# Documentation
*.md text eol=lf

# Configurations
.gitattributes text eol=lf
.gitignore text eol=lf

# Environment Configuration Example
# Copy this file to .env and fill in your values

# ============================================
# TELEGRAM CONFIGURATION (Optional)
# ============================================
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Get your chat ID from @userinfobot on Telegram
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# Enable/disable Telegram notifications
TELEGRAM_ENABLED=true

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
# SMTP Server host
SMTP_HOST=smtp.gmail.com

# SMTP Server port
SMTP_PORT=587

# SMTP Username (usually your email)
SMTP_USER=your-email@gmail.com

# SMTP Password (app password for Gmail)
SMTP_PASSWORD=your-app-password

# From email address
SMTP_FROM_EMAIL=your-email@gmail.com

# Enable/disable Email notifications
EMAIL_ENABLED=false

# ============================================
# DEBUG MODE
# ============================================
DEBUG=false

# ============================================
# Kafka Configuration (Usually no need to change)
# ============================================
# KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# KAFKA_GROUP_ID=notification-service-group

# ============================================
# Database Configuration (Usually no need to change)
# ============================================
# DATABASE_URL=postgresql://notification_user:notification_password@postgres:5432/notification_db

# ============================================
# SERVICE CONFIGURATION (Usually no need to change)
# ============================================
# SERVICE_NAME=notification-service
# SERVICE_PORT=8084
# MESSAGE_PROCESSING_TIMEOUT=30
# MAX_RETRIES=3

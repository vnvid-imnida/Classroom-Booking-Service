# Environment Configuration Example
# Copy this file to .env and fill in your values

# ============================================
# TELEGRAM CONFIGURATION (Optional)
# ============================================
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Get your chat ID from @userinfobot on Telegram
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# Enable/disable Telegram notifications
TELEGRAM_ENABLED=true

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
# SMTP Server host
SMTP_HOST=smtp.gmail.com

# SMTP Server port
SMTP_PORT=587

# SMTP Username (usually your email)
SMTP_USER=your-email@gmail.com

# SMTP Password (app password for Gmail)
SMTP_PASSWORD=your-app-password

# From email address
SMTP_FROM_EMAIL=your-email@gmail.com

# Enable/disable Email notifications
EMAIL_ENABLED=false

# ============================================
# DEBUG MODE
# ============================================
DEBUG=false

# ============================================
# Kafka Configuration (Usually no need to change)
# ============================================
# KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# KAFKA_GROUP_ID=notification-service-group

# ============================================
# Database Configuration
# ============================================
# Docker Compose (backend in container):
# DATABASE_URL=postgresql://notification_user:notification_password@postgres:5432/booking
# Локально: backend на хосте → Postgres в Docker
DATABASE_URL=postgresql://notification_user:notification_password@127.0.0.1:5432/booking

# ============================================
# Backend auth (optional — defaults work for local dev)
# ============================================
# JWT_SECRET=dev-change-me-in-production
# JWT_EXPIRE_HOURS=168
# BCRYPT_ROUNDS=12
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================
# CAPTCHA — Cloudflare Turnstile (optional)
# ============================================
# Create free keys: https://dash.cloudflare.com/ → Turnstile
# Test keys (always pass): site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
# Frontend site key: services/frontend/.env → VITE_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ============================================
# SERVICE CONFIGURATION (Usually no need to change)
# ============================================
# SERVICE_NAME=notification-service
# SERVICE_PORT=8084
# MESSAGE_PROCESSING_TIMEOUT=30
# MAX_RETRIES=3

# ============================================
# Bot / local dev
# ============================================
BACKEND_URL=http://127.0.0.1:8083
FRONTEND_URL=http://localhost:5173

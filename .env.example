# Environment Configuration Example
# Copy this file to .env and fill in your values

# ============================================
# TELEGRAM CONFIGURATION (Optional)
# ============================================
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Get your chat ID from @userinfobot on Telegram
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# Enable/disable Telegram notifications
TELEGRAM_ENABLED=true

# ============================================
# EMAIL — SMTP for verification codes
# ============================================
# Рекомендуется Яндекс (Gmail SMTP часто блокируется сетью):
# https://id.yandex.ru/security/app-passwords
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=spbpu.booking@yandex.ru
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_FROM_EMAIL=spbpu.booking@yandex.ru
EMAIL_ENABLED=true

# ============================================
# DEBUG MODE
# ============================================
DEBUG=false

# ============================================
# Kafka Configuration (Usually no need to change)
# ============================================
# KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# KAFKA_GROUP_ID=notification-service-group

# ============================================
# Database Configuration
# ============================================
# Docker Compose (backend in container):
# DATABASE_URL=postgresql://notification_user:notification_password@postgres:5432/booking
# Локально: backend на хосте → Postgres в Docker
DATABASE_URL=postgresql://notification_user:notification_password@127.0.0.1:5432/booking

# ============================================
# Backend auth (optional — defaults work for local dev)
# ============================================
# JWT_SECRET=dev-change-me-in-production
# JWT_EXPIRE_HOURS=168
# BCRYPT_ROUNDS=12
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================
# CAPTCHA — Cloudflare Turnstile (optional)
# ============================================
# Create free keys: https://dash.cloudflare.com/ → Turnstile
# Test keys (always pass): site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
# Frontend site key: services/frontend/.env → VITE_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ============================================
# SERVICE CONFIGURATION (Usually no need to change)
# ============================================
# SERVICE_NAME=notification-service
# SERVICE_PORT=8084
# MESSAGE_PROCESSING_TIMEOUT=30
# MAX_RETRIES=3

# ============================================
# Сайт и Telegram-бот / local dev
# ============================================
# URL фронтенда (регистрация) — показывается в боте в /start и /help.
# Локально: http://localhost:5173  (npm run dev в services/frontend)
# Публично: https://<ngrok>.ngrok-free.dev  (ngrok http 5173)
FRONTEND_URL=http://localhost:5173
# Доп. origins для CORS (через запятую), если API вызывают напрямую с ngrok-фронта
# CORS_ORIGINS=https://YOUR_SUBDOMAIN.ngrok-free.dev
# Внутренний URL backend для API бота (локально или host.docker.internal в Docker)
BACKEND_URL=http://127.0.0.1:8083

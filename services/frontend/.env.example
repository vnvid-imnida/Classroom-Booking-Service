# Локально (Telegram Web App через ngrok http 5173): оставьте как есть —
# Vite проксирует /api → http://127.0.0.1:8083 (vite.config.ts)
# Проверка dev-сервера: http://127.0.0.1:5173/__health и http://127.0.0.1:5173/login
VITE_API_BASE_URL=/api/v1
# Прямой вызов backend без прокси (нужен CORS_ORIGINS с ngrok-URL в корневом .env):
# VITE_API_BASE_URL=http://127.0.0.1:8083/api/v1
# Отдельный ngrok только на backend (редко):
# VITE_API_BASE_URL=https://BACKEND_SUBDOMAIN.ngrok-free.dev/api/v1

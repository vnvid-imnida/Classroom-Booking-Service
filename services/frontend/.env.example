# Локально (Telegram Web App через ngrok http 5173): оставьте VITE_API_BASE_URL пустым/закомментированным —
# Vite проксирует /api → http://127.0.0.1:8083 (vite.config.ts)
# Проверка dev-сервера: http://127.0.0.1:5173/__health и http://127.0.0.1:5173/login
# VITE_API_BASE_URL=/api/v1
# Прямой вызов backend без прокси (нужен CORS_ORIGINS с ngrok-URL в корневом .env):
# VITE_API_BASE_URL=http://127.0.0.1:8083
# Отдельный ngrok только на backend (редко):
# VITE_API_BASE_URL=https://BACKEND_SUBDOMAIN.ngrok-free.dev/api/v1
# Cloudflare Turnstile site key (public). Test key always passes — replace for production:
# https://developers.cloudflare.com/turnstile/
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
